{
    "swagger": "2.0",
    "info": {
        "description": "API Sistem Kasir dengan Manajemen Stok dan Biaya Operasional.",
        "title": "Backend Cashier API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:4000",
    "basePath": "/",
    "paths": {
        "/api/categories": {
            "get": {
                "description": "Mengambil semua data kategori barang yang tersedia",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Master Data"
                ],
                "summary": "Get Daftar Kategori",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Category"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/expenditure": {
            "get": {
                "tags": [
                    "Reports"
                ],
                "summary": "Laporan Pengeluaran (Filter)",
                "responses": {}
            },
            "post": {
                "tags": [
                    "Transactions"
                ],
                "summary": "Input Pengeluaran (Barang/Operasional)",
                "responses": {}
            }
        },
        "/api/products": {
            "get": {
                "description": "Mengambil data produk, bisa difilter berdasarkan nama atau kode barang",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Master Data"
                ],
                "summary": "Get Daftar Produk",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Cari berdasarkan Nama atau Kode Barang",
                        "name": "search",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.ProductResponse"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/sales": {
            "get": {
                "tags": [
                    "Reports"
                ],
                "summary": "Laporan Penjualan (Filter)",
                "responses": {}
            },
            "post": {
                "tags": [
                    "Transactions"
                ],
                "summary": "Input Penjualan Kasir (Full Detail)",
                "parameters": [
                    {
                        "description": "Payload Penjualan",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.SalesRequest"
                        }
